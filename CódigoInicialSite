<script>
  /* ====== DADOS DOS POSTOS (EXEMPLO — troque pelos dados oficiais) ====== */
  const postos = [
    { nome: "UBS Centro",          bairro: "Centro",         endereco: "Rua Exemplo, 100",        horario: "Seg a Sex, 7h às 17h", telefone: "(31) 0000-0001", servicos: ["Consultas", "Vacinação", "Farmácia"] },
    { nome: "UBS Santo Antônio",   bairro: "Santo Antônio",  endereco: "Av. Exemplo, 250",        horario: "Seg a Sex, 7h às 17h", telefone: "(31) 0000-0002", servicos: ["Consultas", "Odontologia", "Enfermagem"] },
    { nome: "UBS Nova Viçosa",     bairro: "Nova Viçosa",    endereco: "Rua Modelo, 45",          horario: "Seg a Sex, 7h às 16h", telefone: "(31) 0000-0003", servicos: ["Saúde da família", "Vacinação"] },
    { nome: "UBS Bom Jesus",       bairro: "Bom Jesus",      endereco: "Rua Demonstração, 78",    horario: "Seg a Sex, 7h às 17h", telefone: "(31) 0000-0004", servicos: ["Consultas", "Exames", "Farmácia"] },
    { nome: "UBS Silvestre",       bairro: "Silvestre",      endereco: "Av. Ilustrativa, 300",    horario: "Seg a Sex, 7h às 16h", telefone: "(31) 0000-0005", servicos: ["Consultas", "Enfermagem"] },
    { nome: "UBS Amoras",          bairro: "Amoras",         endereco: "Rua Amostra, 12",         horario: "Seg a Sex, 7h às 17h", telefone: "(31) 0000-0006", servicos: ["Saúde da família", "Odontologia", "Vacinação"] }
  ];

  const icones = {
    local: '<svg viewBox="0 0 24 24" fill="none" stroke="#21927E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-7-7-12a7 7 0 0 1 14 0c0 5-7 12-7 12z"/><circle cx="12" cy="9" r="2.500"/></svg>',
    hora:  '<svg viewBox="0 0 24 24" fill="none" stroke="#21927E" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5h4"/></svg>',
    fone:  '<svg viewBox="0 0 24 24" fill="none" stroke="#21927E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>'
  };

  const lista = document.getElementById('listaPostos');
  const semResultado = document.getElementById('semResultado');
  const filtro = document.getElementById('filtroPostos');

  // Ignora acentos e maiúsculas na busca ("vicosa" encontra "Viçosa")
  const normalizar = t => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  function mostrarPostos(termo = '') {
    const busca = normalizar(termo);
    const encontrados = postos.filter(p =>
      normalizar(p.nome).includes(busca) || normalizar(p.bairro).includes(busca)
    );
    lista.innerHTML = encontrados.map(p => `
      <article class="posto">
        <span class="bairro">${p.bairro}</span>
        <h3>${p.nome}</h3>
        <ul>
          <li>${icones.local}<span>${p.endereco}</span></li>
          <li>${icones.hora}<span>${p.horario}</span></li>
          <li>${icones.fone}<span>${p.telefone}</span></li>
        </ul>
        <div class="tags">${p.servicos.map(s => `<span>${s}</span>`).join('')}</div>
      </article>`).join('');
    semResultado.style.display = encontrados.length ? 'none' : 'block';
  }

  filtro.addEventListener('input', e => mostrarPostos(e.target.value));

  // Busca do topo: leva o termo para a seção de postos
  document.getElementById('buscaHero').addEventListener('submit', e => {
    e.preventDefault();
    const termo = document.getElementById('buscaHeroCampo').value;
    filtro.value = termo;
    mostrarPostos(termo);
    document.getElementById('postos').scrollIntoView();
  });

  // Menu no celular
  const menu = document.getElementById('menu');
  const menuBotao = document.getElementById('menuBotao');
  menuBotao.addEventListener('click', () => {
    const aberto = menu.classList.toggle('aberto');
    menuBotao.setAttribute('aria-expanded', aberto);
  });
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.classList.remove('aberto');
    menuBotao.setAttribute('aria-expanded', false);
  }));

  // Destaca no menu a seção visível
  const links = document.querySelectorAll('.menu a.link');
  const observador = new IntersectionObserver(entradas => {
    entradas.forEach(entrada => {
      if (entrada.isIntersecting) {
        links.forEach(l => l.classList.toggle('ativo', l.getAttribute('href') === '#' + entrada.target.id));
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main section[id]').forEach(s => observador.observe(s));

  // Formulário de contato (demonstração: não envia para servidor)
  document.getElementById('formContato').addEventListener('submit', e => {
    e.preventDefault();
    e.target.reset();
    document.getElementById('formOk').style.display = 'block';
  });

  document.getElementById('ano').textContent = new Date().getFullYear();
  mostrarPostos();
</script>
